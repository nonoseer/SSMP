<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Test-only BepInEx plugin that drives a real game client for automated co-op tests.
    It does nothing unless the SSMP_TEST_DIR environment variable is set by Testing/run-coop-test.sh.
    Never ship this plugin to players.
    -->

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyTitle>SSMP.TestBot</AssemblyTitle>
        <Version>0.1.0</Version>
        <BaseOutputPath>..\..\bin\TestBot\</BaseOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SSMP\SSMP.csproj" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" PrivateAssets="all"/>
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" PrivateAssets="all"/>
        <PackageReference Include="Silksong.GameLibs" Version="*-*" PrivateAssets="all"/>
    </ItemGroup>
</Project>
